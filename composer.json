{
    "name": "spottersturkey/seo-pack",
    "description": "Gelişmiş Flarum SEO: Meta Etiketleri, Sitemap ve Google Indexing API Entegrasyonu.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Spotters Turkey Team",
            "email": "info@spottersturkey.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SpottersTurkey\\SeoPack\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Spotters Turkey SEO Pack",
            "icon": {
                "name": "fas fa-truck-moving",
                "backgroundColor": "#de841f",
                "color": "#fff"
            }
        }
    },
    "require": {
        "php": "^8.0",
        "flarum/core": "^2.0 || ^2.0.0-beta.1 || ^2.0.0-rc.1",
        "google/apiclient": "^2.12.1"
    }
}